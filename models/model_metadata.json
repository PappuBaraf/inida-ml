  "local_dataset_audit": {
    "filename": "Benign-Monday-no-metadata.parquet",
    "total_records": 458831,
    "feature_count": 77,
    "labels_present": ["BENIGN"],
    "attack_records_count": 0,
    "training_safety_status": "UNSAFE_FOR_BINARY_SUPERVISED_TRAINING",
    "rationale": "Monday dataset contains purely benign baseline traffic recorded during normal operations. Training a binary classifier on this file alone yields an invalid zero-attack class distribution (class imbalance infinity), producing 0% recall on actual intrusion vectors. Multi-class intrusion models require Wednesday (DoS/Heartbleed), Thursday (Web Attacks/Infiltration), and Friday (DDoS/PortScan/Botnet) captures."
  },
  "intended_architecture": {
    "algorithm": "Random Forest Classifier (Ensemble of Decision Trees)",
    "n_estimators": 100,
    "max_depth": 25,
    "criterion": "gini",
    "feature_scaling": "RobustScaler / StandardScaler for continuous flow metrics",
    "class_weighting": "balanced_subsample"
  },
