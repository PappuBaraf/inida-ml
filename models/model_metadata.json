{
  "project_name": "INIDA-ML: Intelligent Network Intrusion Detection and Anomaly Analysis System",
  "platform": "Network Intrusion Detection & Threat Analysis Platform",
  "dataset_source": "CIC-IDS2017 (Canadian Institute for Cybersecurity, University of New Brunswick)",
  "dataset_links": {
